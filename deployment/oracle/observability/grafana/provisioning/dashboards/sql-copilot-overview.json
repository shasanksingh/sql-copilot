      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto"},
      "targets": [{"expr": "sum(rate(sql_copilot_query_requests_total[5m]))", "refId": "A"}],
      "title": "SQL requests / second",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "sql-copilot-prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto"},
      "targets": [{"expr": "sum(rate(sql_copilot_validation_total{valid=\"true\"}[5m])) / clamp_min(sum(rate(sql_copilot_validation_total[5m])), 1)", "refId": "A"}],
      "title": "Validated response rate",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "sql-copilot-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto"},
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(sql_copilot_query_duration_seconds_bucket[5m])) by (le))", "refId": "A"}],
      "title": "P95 query latency",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "sql-copilot-prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 4,
      "targets": [{"expr": "sum(rate(sql_copilot_cache_total{result=\"hit\"}[5m])) / clamp_min(sum(rate(sql_copilot_cache_total[5m])), 1)", "refId": "A"}],
