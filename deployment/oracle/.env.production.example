# Oracle VM production-only file. Copy to .env.production and fill the secrets there.
APP_ENV=production
FRONTEND_ORIGIN=https://sql-copilot-frontend.singhshasank50.workers.dev
FRONTEND_ORIGINS=https://sql-copilot-frontend.singhshasank50.workers.dev
AUTH_COOKIE_SECURE=1
AUTH_JWT_SECRET=
NVIDIA_API_KEY=
SQL_COPILOT_LLM_PROVIDER=nvidia
SQL_COPILOT_REMOTE_LLM=1
SQL_COPILOT_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
SQL_COPILOT_CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_TIMEOUT_SECONDS=35
LLM_MAX_TOKENS=1200
LLM_MAX_RETRIES=1
LLM_TOP_P=0.95
# Set a small non-zero budget only when deeper reasoning is worth the added latency.
LLM_REASONING_BUDGET=0

# Optional observability. Keep these backend-only; never put them in frontend env files.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sql-copilot-production
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Redaction is on by default: traces retain timings and result metadata, not prompts or SQL.
LANGSMITH_REDACT_CONTENT=true
METRICS_BEARER_TOKEN=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=http://127.0.0.1:3000
