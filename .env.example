# Copy to .env or set these variables in your shell before starting the backend.
# Keep generated runtime data and caches off C: when the repo lives on D:.

SQL_COPILOT_PROJECT_ROOT=D:\Projects\EnterpriseSQLCopilot
SQL_COPILOT_RUNTIME_DIR=D:\Projects\EnterpriseSQLCopilot\.runtime
SQL_COPILOT_CACHE_DIR=D:\Projects\EnterpriseSQLCopilot\.runtime\cache
SQL_COPILOT_SQLITE_DIR=D:\Projects\EnterpriseSQLCopilot\.runtime\sqlite
SQL_COPILOT_LOG_DIR=D:\Projects\EnterpriseSQLCopilot\.runtime\logs
SQL_COPILOT_TEMP_DIR=D:\Projects\EnterpriseSQLCopilot\.runtime\tmp
SQL_COPILOT_FAISS_DIR=D:\Projects\EnterpriseSQLCopilot\.runtime\cache\faiss
SQL_COPILOT_MODEL_DIR=D:\AIModels
AI_MODELS_DIR=D:\AIModels

HF_HOME=D:\AIModels\huggingface
TRANSFORMERS_CACHE=D:\AIModels\huggingface\transformers
TORCH_HOME=D:\AIModels\torch
PIP_CACHE_DIR=D:\Projects\EnterpriseSQLCopilot\.runtime\cache\pip
NPM_CONFIG_CACHE=D:\Projects\EnterpriseSQLCopilot\.runtime\cache\npm
TEMP=D:\Projects\EnterpriseSQLCopilot\.runtime\tmp
TMP=D:\Projects\EnterpriseSQLCopilot\.runtime\tmp

APP_ENV=development
FRONTEND_ORIGIN=http://127.0.0.1:4000
FRONTEND_ORIGINS=http://127.0.0.1:4000,http://localhost:4000
AUTH_DB_PATH=D:\Projects\EnterpriseSQLCopilot\.runtime\sqlite\sql_copilot.db
SCHEMA_REQUEST_DB_PATH=D:\Projects\EnterpriseSQLCopilot\.runtime\sqlite\sql_copilot.db
AGENT_FEEDBACK_DB_PATH=D:\Projects\EnterpriseSQLCopilot\.runtime\sqlite\sql_agent_feedback.sqlite
RL_MODEL_PATH=D:\AIModels\rl\sql_ppo_agent.zip

# Provider selection. NVIDIA is the built-in remote provider.
# Leave NVIDIA_API_KEY empty to keep the deterministic local fallback active.
SQL_COPILOT_LLM_PROVIDER=nvidia
SQL_COPILOT_REMOTE_LLM=1
SQL_COPILOT_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
SQL_COPILOT_CHAT_MODEL=openai/gpt-oss-20b
SQL_COPILOT_EMBEDDING_MODEL=
SQL_COPILOT_LOCAL_MODEL=qwen2.5-coder:1.5b
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=0
LLM_TEMPERATURE=1
LLM_TOP_P=1
LLM_MAX_TOKENS=4096
LLM_PROVIDER_FAILURE_COOLDOWN_SECONDS=0
MAX_GENERATION_RETRIES=3
CONFIDENCE_LOW_THRESHOLD=75
CONFIDENCE_HIGH_THRESHOLD=90
CONFIDENCE_WEIGHTS_JSON=
USE_SCHEMA_GRAPH=true
USE_BUSINESS_LOGIC=true
USE_HYBRID_RETRIEVAL=true
USE_LLM_PLANNER=true
USE_LLM_CRITIC=true
USE_VALIDATOR=true

# NVIDIA GPT-OSS-20B API mode. Keep the key in your local .env or shell only.
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional custom OpenAI-compatible provider. Use only when you intentionally
# switch away from NVIDIA in the Settings page or your local shell.
# LLM_PROVIDER=openai
# LLM_MODEL=
# LLM_API_KEY=
# LLM_API_BASE=https://api.openai.com/v1

# Password reset email delivery. Without SMTP settings, development reset
# emails are written to EMAIL_OUTBOX_DIR and the UI shows the local reset link.
EMAIL_BACKEND=file
EMAIL_OUTBOX_DIR=D:\Projects\EnterpriseSQLCopilot\.runtime\mail-outbox
PASSWORD_RESET_BASE_URL=http://127.0.0.1:4000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1
SMTP_USE_SSL=0
SMTP_TIMEOUT_SECONDS=20

# Optional local Ollama mode, no model download is triggered by this app.
# SQL_COPILOT_LLM_PROVIDER=ollama
# SQL_COPILOT_LLM_BASE_URL=http://127.0.0.1:11434/v1
# SQL_COPILOT_CHAT_MODEL=qwen2.5-coder:1.5b
